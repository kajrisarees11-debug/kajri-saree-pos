# Copy this file to .env.local for local development (next dev / npm run electron:dev).
# .env.local is gitignored and never committed — do not put real secrets in this file.
#
# The packaged Electron desktop app does NOT read this file: it generates and
# persists its own JWT_SECRET/ADMIN_PIN on first launch (see electron/main.js,
# ensureLocalCredentials()). These variables are only needed for local dev and
# for the Vercel/cloud deployment.

# Required for login (no default — the app refuses to start auth without these).
# JWT_SECRET: any long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# ADMIN_PIN: the PIN typed into the POS login screen.
ADMIN_PIN=

# Required only when running against MongoDB (Vercel deployment, or
# USE_MONGODB=true locally). Not needed for local SQLite-backed dev.
MONGODB_URI=
